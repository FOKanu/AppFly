# Google AI Studio / Gemini API (paid tier recommended).
# Create a key at https://aistudio.google.com/apikey
# Prefer Settings (Keychain). This env var is a runtime fallback only.
GEMINI_API_KEY=

# Apify token for public company/Impressum pages only (never deny-listed job boards).
# Prefer Settings (Keychain). Runtime fallback only; leave blank until you use Apify.
APIFY_TOKEN=

# Arbeitsagentur Jobsuche public client key (documented by bund.dev).
# Default value is the published client id; override only if BA rotates it.
# Settings treats this default as NOT "configured custom".
JOBSUCHE_API_KEY=jobboerse-jobsuche
